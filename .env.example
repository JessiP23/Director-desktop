# Copy to `.env.local` and fill in. These are all client-side (Vite) values;
# the Supabase anon key is public by design. No server secrets live here.

# WM Studio backend origin (no trailing slash).
#   - Production: https://your-app.azurewebsites.net
#   - Local backend: http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Supabase project — same project the web app uses.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
