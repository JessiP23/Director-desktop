{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Director",
  "version": "0.1.4",
  "identifier": "com.jessipavia.director-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Director",
        "width": 1280,
        "height": 832,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' http://localhost:* https: wss:; style-src 'self' 'unsafe-inline'; font-src 'self' data: https:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/JessiP23/Director-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEM0Y5NjMyNURCREEwMEUKUldRT29MMWRNcFkvSFdiZ2tVL2lXWTJZekNlbk9EVTRLNGdzQkhDaFVZR0QrOFVBVzl3NkZjQzYK"
    }
  }
}
