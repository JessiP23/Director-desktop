{
  "name": "director-desktop",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "release:dmg": "bash scripts/release-dmg.sh",
    "release:github": "bash scripts/release-dmg.sh --upload",
    "release:verify": "node scripts/updater-verify.mjs",
    "release:e2e": "node scripts/updater-e2e.mjs --current 0.0.9",
    "release:apple:check": "bash scripts/apple-release-check.sh",
    "release:apple": "pnpm release:apple:check && pnpm tauri build --bundles dmg --config src-tauri/tauri.macos.conf.json",
    "release:apple:github": "pnpm release:apple:check && bash scripts/release-dmg.sh --upload",
    "typecheck": "tsc --noEmit",
    "smoke": "node --env-file=.env.local scripts/smoke.mjs"
  },
  "dependencies": {
    "@fabianlars/tauri-plugin-oauth": "^2",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@supabase/supabase-js": "^2.48.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@xyflow/react": "^12.11.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.20.0",
    "mediabunny": "^1.49.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
